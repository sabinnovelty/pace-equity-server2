{
  "name": "gold-v2",
  "private": true,
  "scripts": {
    "create-feature": "ts-node cli/cli.ts create-feature",
    "create-repo-contents": "ts-node cli/cli.ts create-repo-contents",
    "create-microservice": "ts-node cli/cli.ts create-microservice",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "local": "dotenvx run -f .env.local -- nest start --debug 0.0.0.0:9000 --watch 'node --inspect-brk'",
    "server": "dotenvx run -f .env -- nest start --debug 0.0.0.0:9000 --watch 'node --inspect-brk'",
    "test": "jest --passWithNoTests",
    "test:failedOnly": "jest --onlyFailures",
    "test:watch": "jest --watch --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-license-header": "^0.6.1",
    "eslint-plugin-perfectionist": "^2.10.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.3.3",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.5.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.614.0",
    "@aws-sdk/s3-request-presigner": "^3.614.0",
    "@dotenvx/dotenvx": "^1.39.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.6.8",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.6",
    "cron": "^3.1.7",
    "ioredis": "^5.5.0",
    "ipaddr.js": "^2.2.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "kafkajs": "^2.2.4",
    "luxon": "^3.4.4",
    "nestjs-zod": "^3.0.0",
    "pg": "^8.14.1",
    "pino": "^8.20.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^3.22.4"
  }
}
